{
  "name": "rmm-desk",
  "productName": "RMM Desk",
  "version": "1.0.0",
  "description": "Desktop-App zur Fernwartung und Überwachung deiner Clients",
  "main": "main.js",
  "private": true,
  "author": "RMM Desk",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.rmmdesk.app",
    "productName": "RMM Desk",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "node_modules/@xterm/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RMM Desk"
    }
  }
}
