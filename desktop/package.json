{
  "name": "bolzo-rmm",
  "productName": "BOLZO RMM",
  "version": "1.1.1",
  "description": "Desktop-App zur Fernwartung und Überwachung deiner Clients",
  "main": "main.js",
  "private": true,
  "author": "BOLZO RMM",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/render-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "release": "electron-builder --win --publish never && node build/release.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "net.bolzo.rmm",
    "productName": "BOLZO RMM",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "node_modules/@xterm/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BOLZO RMM",
      "artifactName": "BOLZO-RMM-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rick7O7",
        "repo": "bolzo-rmm",
        "releaseType": "release"
      }
    ]
  }
}
